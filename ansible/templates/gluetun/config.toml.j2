# Gluetun HTTP control server auth roles:
# https://github.com/qdm12/gluetun-wiki/blob/main/setup/advanced/control-server.md

[[roles]]
name = "homepage"
routes = ["GET /v1/publicip/ip"]
auth = "apikey"
apikey = "{{ gluetun_api_key }}"

[[roles]]
name = "local_apps"
routes = ["GET /v1/portforward", "GET /v1/vpn/status"]
auth = "none"
