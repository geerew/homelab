# DO NOT EDIT THIS FILE MANUALLY.
# Generated by Ansible from authelia-users.yml
# Re-render: ansible-playbook playbooks/deploy-authelia.yml

users:
{% for username, user in authelia_users_hashed.items() %}
  {{ username }}:
    displayname: "{{ user.display_name }}"
    email: "{{ user.email }}"
    password: "{{ user.password_hash }}"
{% if user.groups | length > 0 %}
    groups:
{% for group in user.groups %}
      - {{ group }}
{% endfor %}
{% endif %}
{% endfor %}
