# DO NOT EDIT THIS FILE MANUALLY.
# Generated by Ansible from ansible/templates/authelia/configuration.yml.j2
# Re-render: ansible-playbook playbooks/deploy-authelia.yml

server:
  address: 'tcp://:9091'

log:
  level: 'info'

identity_validation:
  reset_password:
    jwt_secret: '{{ homelab_env.AUTHELIA_JWT_SECRET }}'

authentication_backend:
  file:
    path: /config/users.yml
    watch: true

session:
  name: 'authelia_session'
  secret: '{{ homelab_env.AUTHELIA_SESSION_SECRET }}'
  cookies:
    - domain: '{{ homelab_env.DOMAIN }}'
      authelia_url: 'https://auth.{{ homelab_env.DOMAIN }}'
      default_redirection_url: 'https://traefik.{{ homelab_env.DOMAIN }}'

storage:
  encryption_key: '{{ homelab_env.AUTHELIA_STORAGE_ENCRYPTION_KEY }}'
  local:
    path: /config/db.sqlite3

notifier:
  filesystem:
    filename: /config/notification.txt

access_control:
  default_policy: 'deny'
  rules:
    - domain: 'auth.{{ homelab_env.DOMAIN }}'
      policy: 'bypass'

    - domain: 'vpn-status.{{ homelab_env.DOMAIN }}'
      networks:
        - {{ docker_network_traefik_subnet }}
        - {{ docker_network_socket_proxy_subnet }}
      policy: 'bypass'

    - domain: '*.{{ homelab_env.DOMAIN }}'
      policy: 'one_factor'

identity_providers:
  oidc:
    hmac_secret: '{{ homelab_env.AUTHELIA_OIDC_HMAC_SECRET }}'

    cors:
      endpoints:
        - 'token'
      allowed_origins:
{% for client_id, client in authelia_oidc_clients.items() %}
{% if client.subdomain is defined %}
        - 'https://{{ client.subdomain }}.{{ homelab_env.DOMAIN }}'
{% endif %}
{% endfor %}

    jwks:
      - key: |
{{ lookup('file', authelia_jwks_file) | indent(10, true) }}

    claims_policies:
      sparkyfitness:
        id_token:
          - email
          - preferred_username
          - name
          - groups

    clients:
{% for client_id, client in authelia_oidc_clients.items() %}
      - client_id: '{{ client_id }}'
        client_name: '{{ client.client_name }}'
        client_secret: '{{ authelia_oidc_client_secret_hash }}'
        public: false
        authorization_policy: 'one_factor'
{% if client.require_pkce is defined %}
        require_pkce: {{ client.require_pkce | string | lower }}
{% endif %}
{% if client.pkce_challenge_method is defined and client.pkce_challenge_method | length > 0 %}
        pkce_challenge_method: '{{ client.pkce_challenge_method }}'
{% elif client.pkce_challenge_method is defined %}
        pkce_challenge_method: ''
{% endif %}
{% if client.consent_mode is defined %}
        consent_mode: {{ client.consent_mode }}
{% endif %}
        redirect_uris:
{% for path in client.redirect_paths | default([]) %}
          - 'https://{{ client.subdomain }}.{{ homelab_env.DOMAIN }}{{ path }}'
{% endfor %}
{% for uri in client.extra_redirect_uris | default([]) %}
          - '{{ uri }}'
{% endfor %}
{% if client.scopes is defined %}
        scopes:
{% for scope in client.scopes %}
          - '{{ scope }}'
{% endfor %}
{% endif %}
{% if client.response_types is defined %}
        response_types:
{% for response_type in client.response_types %}
          - '{{ response_type }}'
{% endfor %}
{% endif %}
{% if client.grant_types is defined %}
        grant_types:
{% for grant_type in client.grant_types %}
          - '{{ grant_type }}'
{% endfor %}
{% endif %}
{% if client.access_token_signed_response_alg is defined %}
        access_token_signed_response_alg: '{{ client.access_token_signed_response_alg }}'
{% endif %}
{% if client.userinfo_signed_response_alg is defined %}
        userinfo_signed_response_alg: '{{ client.userinfo_signed_response_alg }}'
{% endif %}
        token_endpoint_auth_method: '{{ client.token_endpoint_auth_method }}'

{% endfor %}
