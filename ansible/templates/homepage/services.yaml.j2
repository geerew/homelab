- Services:
    - Jellyfin:
        icon: sh-jellyfin
        href: https://tv.{{ homelab_env.DOMAIN }}/
        description: Jellyfin Media Server
        server: local
        container: jellyfin
        widget:
          type: jellyfin
          url: https://tv.{{ homelab_env.DOMAIN }}/
          key: {{ jellyfin_api_key }}
          version: 2
          enableBlocks: true
          enableNowPlaying: true
          enableUser: true
          showEpisodeNumber: true
          expandOneStreamToTwoRows: false
          fields: ["movies", "series"]

    - Jellyscope:
        icon: mdi-chart-box-outline
        href: https://tv-stats.{{ homelab_env.DOMAIN }}/
        description: Jellyfin Stats
        server: local
        container: jellyscope

    - Audiobookshelf:
        icon: sh-audiobookshelf
        href: https://books.{{ homelab_env.DOMAIN }}/
        description: Audiobooks
        server: local
        container: audiobookshelf
        widget:
          type: audiobookshelf
          url: https://books.{{ homelab_env.DOMAIN }}/
          key: {{ homelab_env.HOMEPAGE_AUDIOBOOKSHELF_API_KEY }}
          fields: ["books"]

    - qBittorrent:
        icon: sh-qbittorrent
        href: https://torrents.{{ homelab_env.DOMAIN }}/
        server: local
        container: qbittorrent
        widget:
          type: qbittorrent
          url: http://gluetun:{{ homelab_env.QBITTORRENT_WEBUI_PORT | default('9865') }}

    - Mealie:
        icon: sh-mealie
        href: https://food.{{ homelab_env.DOMAIN }}/
        description: Recipe Manager
        server: local
        container: mealie
        widget:
          type: mealie
          url: http://mealie:9000/
          key: {{ homelab_env.HOMEPAGE_MEALIE_API_KEY }}
          version: 2
          fields: ["recipes"]

    - Memos:
        icon: sh-memos
        href: https://notes.{{ homelab_env.DOMAIN }}/
        description: Notes
        server: local
        container: memos

    - SparkyFitness:
        icon: mdi-weight-lifter
        href: https://fitness.{{ homelab_env.DOMAIN }}/
        description: Fitness & Nutrition Tracker
        server: local
        container: sparkyfitness-frontend

