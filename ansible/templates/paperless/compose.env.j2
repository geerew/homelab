# DO NOT EDIT — rendered by deploy-paperless.yml
{% if paperless_secret_key | default('') | length > 0 %}
PAPERLESS_SECRET_KEY={{ paperless_secret_key }}
{% endif %}
PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
PAPERLESS_SOCIALACCOUNT_PROVIDERS={{ homelab_env.PAPERLESS_SOCIALACCOUNT_PROVIDERS }}
PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS=true
PAPERLESS_SOCIAL_ACCOUNT_SYNC_SUPERUSER_GROUP={{ homelab_env.PAPERLESS_OIDC_SUPERUSER_GROUP }}
{% if homelab_env.PAPERLESS_OIDC_STAFF_GROUP | default('') | length > 0 %}
PAPERLESS_SOCIAL_ACCOUNT_SYNC_STAFF_GROUP={{ homelab_env.PAPERLESS_OIDC_STAFF_GROUP }}
{% endif %}
