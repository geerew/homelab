# Local config with secrets — never commit
homelab.yaml

# Rendered compose (secrets baked in) — source is compose.tpl.yaml
compose.yaml

# Old compose files (moved here; contain secrets)
archive/

# All service data lives under services/ — created by Ansible, not in Git
services/

# Pre-deploy snapshots from Ansible (backups/<service>/<timestamp>/)
backups/

# Ansible
ansible/*.retry
