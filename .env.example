# =============================================================================
# Core
# =============================================================================

# Data root for all service volumes (repo root or an external path)
DATA_DIR=./

# User/group for file ownership in containers (match your host user)
PUID=1000
PGID=1000

# Timezone for containers
TZ=Europe/London

# Primary domain (Traefik Host rules, app URLs, Authelia cookie domain)
DOMAIN=example.com


# =============================================================================
# Traefik / DNS
# =============================================================================

# Email for Let's Encrypt certificate registration
ACME_EMAIL=admin@example.com

# Cloudflare API token (DDNS + Traefik ACME DNS challenge)
CLOUDFLARE_API_TOKEN=


# =============================================================================
# Authelia — SSO / forward auth
# Deploy: ansible/playbooks/deploy-authelia.yml
# =============================================================================
#
# Before first deploy:
#   1. Fill in the four AUTHELIA_* secrets below (generate once, keep forever)
#   2. Set OIDC_CLIENT_SECRET (plain text — same value goes in Mealie/Jellyfin/etc.)
#   3. Set AUTHELIA_JWKS_FILE and generate the PEM at that path (see below)
#   4. Copy authelia-users.example.yml → authelia-users.yml and add your users
#   5. Run: cd ansible && ansible-playbook playbooks/deploy-authelia.yml
#
# Generate random secrets (run four times, paste each result into a var below):
#   docker run --rm authelia/authelia:latest authelia crypto rand --length 64

# Signs session cookies after login.
AUTHELIA_SESSION_SECRET=

# Signs password-reset and identity-validation JWTs (reset links, email verify).
AUTHELIA_JWT_SECRET=

# Encrypts db.sqlite3 at runtime. Set once before first start — changing it later makes the DB unreadable.
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# HMAC key for Authelia's OIDC provider.
AUTHELIA_OIDC_HMAC_SECRET=

# Plain OIDC client secret for Mealie, Jellyfin, Audiobookshelf, etc.
# Ansible stores a PBKDF2 hash in configuration.yml; each app uses this plain value.
OIDC_CLIENT_SECRET=

# Optional override if authelia-users.yml is not at the repo root
# AUTHELIA_USERS_FILE=./authelia-users.yml

# Path to the OIDC token signing key (RSA private key PEM, gitignored).
# Authelia uses this to sign OIDC login tokens for Mealie, Jellyfin, etc.
# Ansible embeds the file into configuration.yml — it is never auto-generated.
# Generate the file once at this path before first deploy:
#   docker run --rm -v "$PWD:/out" authelia/authelia:latest \
#     authelia crypto pair rsa generate -d /out --file.private-key authelia-jwks.pem
AUTHELIA_JWKS_FILE=./authelia-jwks.pem


# =============================================================================
# Mealie
# =============================================================================

# OpenAI for recipe import/features (optional — leave blank to disable)
MEALIE_OPENAI_API_KEY=


# =============================================================================
# Gluetun / VPN
# Deploy: ansible/playbooks/deploy-gluetun.yml
# =============================================================================

# HTTP control-server API key (generate: docker run --rm qmcgaw/gluetun genkey)
GLUETUN_API_KEY=

# Mullvad WireGuard private key
WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=10.x.x.x/32  # if not using SERVER_CITIES


# =============================================================================
# qBittorrent
# Deploy: ansible/playbooks/deploy-qbittorrent.yml
# =============================================================================

QBITTORRENT_WEBUI_USERNAME=admin
QBITTORRENT_WEBUI_PASSWORD=
QBITTORRENT_WEBUI_PORT=9865
# Whitelist traefik_network so Traefik/Homepage skip WebUI login (Authelia handles external auth)
# *arr apps on gluetun still use QBITTORRENT_WEBUI_USERNAME/PASSWORD for the download-client API
QBITTORRENT_LAN_AUTH_BYPASS=true


# =============================================================================
# Media paths
# =============================================================================

MEDIA1_DIR=/mnt/media1
MEDIA2_DIR=/mnt/media2
AUDIOBOOKS_DIR=/mnt/audiobooks
DOWNLOADS_DIR=/path/to/downloads


# =============================================================================
# Dispatcharr
# Deploy: ansible/playbooks/deploy-dispatcharr.yml
# =============================================================================

# Admin account (UI + XC username)
DISPATCHARR_ADMIN_USERNAME=admin
DISPATCHARR_ADMIN_PASSWORD=
DISPATCHARR_ADMIN_EMAIL=admin@example.com
# Trust no proxy headers (recommended behind Traefik + Gluetun)
DISPATCHARR_TRUSTED_PROXIES=none
# Block web signup; admin is created by deploy-dispatcharr.yml
DISPATCHARR_SETUP_ALLOWED_IP=127.0.0.1

# M3U/XC provider
DISPATCHARR_M3U_NAME=MyProvider
DISPATCHARR_M3U_URL=http://your-provider.example.com
DISPATCHARR_M3U_USERNAME=
DISPATCHARR_M3U_PASSWORD=
# XC = Xtream Codes base URL + username/password; STD = direct M3U playlist URL
DISPATCHARR_M3U_ACCOUNT_TYPE=XC
# Max concurrent streams for this provider (0 = unlimited)
DISPATCHARR_M3U_MAX_STREAMS=1

# XC password for IPTV clients (UHF, iPlayTV, etc.) — remote access via Traefik
# Username is DISPATCHARR_ADMIN_USERNAME; server URL is https://dispatch.${DOMAIN}
DISPATCHARR_XC_PASSWORD=


# =============================================================================
# Uptime Kuma
# =============================================================================

# Health-check URLs with API keys embedded (keeps keys out of compose.yaml)
# Optional — use if your *arr apps require an API key in the status URL
# KUMA_SONARR_URL=http://gluetun:8989/api/v3/system/status?apiKey=YOUR_KEY
# KUMA_RADARR_URL=http://gluetun:7878/api/v3/system/status?apiKey=YOUR_KEY
# KUMA_PROWLARR_URL=http://gluetun:9696/api/v1/system/status?apiKey=YOUR_KEY
# KUMA_BAZARR_URL=http://gluetun:6767/api/system/status?apikey=YOUR_KEY
# KUMA_DISPATCHARR_URL=http://dispatcharr:9191


# =============================================================================
# Jellyfin
# Deploy: ansible/playbooks/deploy-jellyfin.yml
# =============================================================================

# API key (Dashboard → API Keys) — Live TV channel refresh
JELLYFIN_API_KEY=


# =============================================================================
# Homepage
# Deploy: ansible/playbooks/deploy-homepage.yml
# =============================================================================

# Per-app API tokens — create in each service UI after the stack is up
HOMEPAGE_JELLYFIN_API_KEY=
HOMEPAGE_AUDIOBOOKSHELF_API_KEY=
HOMEPAGE_MEALIE_API_KEY=
HOMEPAGE_WALLOS_API_KEY=
HOMEPAGE_SONARR_API_KEY=
HOMEPAGE_RADARR_API_KEY=
HOMEPAGE_PROWLARR_API_KEY=
HOMEPAGE_SEERR_API_KEY=
HOMEPAGE_BAZARR_API_KEY=
HOMEPAGE_TRAEFIK_USERNAME=
HOMEPAGE_TRAEFIK_PASSWORD=
