# =============================================================================
# Core
# =============================================================================

# Data root for all service volumes (repo root or an external path)
DATA_DIR=./

# User/group for file ownership in containers (match your host user)
PUID=1000
PGID=1000

# Timezone for containers
TZ=Europe/London

# Primary domain (Traefik Host rules, app URLs, Authelia cookie domain)
DOMAIN=example.com


# =============================================================================
# Socket Proxy
# Deploy: ansible/playbooks/deploy-socket-proxy.yml
# =============================================================================
# Filtered Docker API for Traefik, Homepage, Dozzle, and Autokuma (tcp://socket-proxy:2375).
# 1 = allow, 0 = deny — see linuxserver/socket-proxy docs before changing.

SOCKET_PROXY_LOG_LEVEL=warning
SOCKET_PROXY_ALLOW_START=1
SOCKET_PROXY_ALLOW_STOP=1
SOCKET_PROXY_ALLOW_RESTARTS=1
SOCKET_PROXY_EVENTS=1
SOCKET_PROXY_PING=1
SOCKET_PROXY_VERSION=1
SOCKET_PROXY_AUTH=0
SOCKET_PROXY_SECRETS=0
SOCKET_PROXY_POST=1
SOCKET_PROXY_BUILD=0
SOCKET_PROXY_COMMIT=0
SOCKET_PROXY_CONFIGS=0
SOCKET_PROXY_CONTAINERS=1
SOCKET_PROXY_DISTRIBUTION=0
SOCKET_PROXY_EXEC=0
SOCKET_PROXY_IMAGES=1
SOCKET_PROXY_INFO=1
SOCKET_PROXY_NETWORKS=1
SOCKET_PROXY_NODES=0
SOCKET_PROXY_PLUGINS=0
SOCKET_PROXY_SERVICES=1
SOCKET_PROXY_SESSION=0
SOCKET_PROXY_SWARM=0
SOCKET_PROXY_SYSTEM=0
SOCKET_PROXY_TASKS=1
SOCKET_PROXY_VOLUMES=1
SOCKET_PROXY_DISABLE_IPV6=0


# =============================================================================
# Watchtower
# Deploy: ansible/playbooks/deploy-watchtower.yml
# =============================================================================

# Remove old images after updating labelled containers
WATCHTOWER_CLEANUP=true
# Check interval in seconds (86400 = daily)
WATCHTOWER_POLL_INTERVAL=86400
# Only update containers with com.centurylinklabs.watchtower.enable=true
WATCHTOWER_LABEL_ENABLE=true


# =============================================================================
# Dozzle
# Deploy: ansible/playbooks/deploy-dozzle.yml
# =============================================================================
# Log viewer at https://logs.${DOMAIN}/ (Authelia via Traefik).
# Requires Socket Proxy running (DOZZLE_REMOTE_HOST).

DOZZLE_LEVEL=info
DOZZLE_FILTER=status=running
DOZZLE_REMOTE_HOST=tcp://socket-proxy:2375
# Trust Authelia forward-auth header from Traefik (Remote-User)
DOZZLE_AUTH_PROVIDER=forward-proxy
DOZZLE_AUTH_HEADER_USER=Remote-User


# =============================================================================
# Traefik / DNS
# =============================================================================

# Email for Let's Encrypt certificate registration
ACME_EMAIL=admin@example.com

# Cloudflare API token (DDNS + Traefik ACME DNS challenge)
CLOUDFLARE_API_TOKEN=


# =============================================================================
# Cloudflare DDNS
# Deploy: ansible/playbooks/deploy-cloudflare-ddns.yml
# =============================================================================

# DNS records to keep updated (comma-separated — apex + wildcard for subdomains)
CLOUDFLARE_DDNS_DOMAINS=example.com,*.example.com
# Route traffic through Cloudflare proxy (orange cloud)
CLOUDFLARE_DDNS_PROXIED=true
# Use Cloudflare trace endpoint to detect public IP
CLOUDFLARE_DDNS_DETECTION_MODE=cloudflare.trace
CLOUDFLARE_DDNS_HTTP_TIMEOUT=10s


# =============================================================================
# Authelia — SSO / forward auth
# Deploy: ansible/playbooks/deploy-authelia.yml
# =============================================================================
#
# Before first deploy:
#   1. Fill in the four AUTHELIA_* secrets below (generate once, keep forever)
#   2. Set OIDC_CLIENT_SECRET (plain text — same value goes in Mealie/Jellyfin/etc.)
#   3. Set AUTHELIA_JWKS_FILE and generate the PEM at that path (see below)
#   4. Copy authelia-users.example.yml → authelia-users.yml and add your users
#   5. Run: cd ansible && ansible-playbook playbooks/deploy-authelia.yml
#
# Generate random secrets (run four times, paste each result into a var below):
#   docker run --rm authelia/authelia:latest authelia crypto rand --length 64

# Signs session cookies after login.
AUTHELIA_SESSION_SECRET=

# Signs password-reset and identity-validation JWTs (reset links, email verify).
AUTHELIA_JWT_SECRET=

# Encrypts db.sqlite3 at runtime. Set once before first start — changing it later makes the DB unreadable.
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# HMAC key for Authelia's OIDC provider.
AUTHELIA_OIDC_HMAC_SECRET=

# Plain OIDC client secret for Mealie, Jellyfin, Audiobookshelf, Memos, etc.
# Ansible stores a PBKDF2 hash in configuration.yml; each app uses this plain value.
OIDC_CLIENT_SECRET=

# Optional override if authelia-users.yml is not at the repo root
# AUTHELIA_USERS_FILE=./authelia-users.yml

# Path to the OIDC token signing key (RSA private key PEM, gitignored).
# Authelia uses this to sign OIDC login tokens for Mealie, Jellyfin, etc.
# Ansible embeds the file into configuration.yml — it is never auto-generated.
# Generate the file once at this path before first deploy:
#   docker run --rm -v "$PWD:/out" authelia/authelia:latest \
#     authelia crypto pair rsa generate -d /out --file.private-key authelia-jwks.pem
AUTHELIA_JWKS_FILE=./authelia-jwks.pem


# =============================================================================
# Memos — instance admin (bootstrapped on first install)
# Deploy: ansible/playbooks/deploy-memos.yml
# =============================================================================
#
# Memos requires at least one user before the setup wizard clears. Ansible creates
# this account via API on first install only. Sign in at /auth/admin for local admin
# access; daily use Authelia SSO on the main login page.

MEMOS_ADMIN_USERNAME=admin
MEMOS_ADMIN_PASSWORD=
# Optional — defaults to MEMOS_ADMIN_USERNAME@DOMAIN
# MEMOS_ADMIN_EMAIL=admin@example.com


# =============================================================================
# Mealie
# =============================================================================

# OpenAI for recipe import/features (optional — leave blank to disable)
MEALIE_OPENAI_API_KEY=


# =============================================================================
# Gluetun / VPN
# Deploy: ansible/playbooks/deploy-gluetun.yml
# =============================================================================

# VPN provider and protocol — see https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard

# WireGuard credentials from your VPN provider account
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# Server selection — comma-separated city/country names (provider-specific)
SERVER_CITIES=

# DNS — provider DNS address; GLUETUN_DOT=off disables DNS-over-TLS
GLUETUN_DOT=off
GLUETUN_DNS_ADDRESS=10.64.0.1

# Allow Traefik/Homepage to reach *arr WebUIs on gluetun (match traefik_network subnet)
FIREWALL_OUTBOUND_SUBNETS=192.168.90.0/24


# =============================================================================
# Gluetun — published ports
# =============================================================================
# Host ports on the gluetun container (*arr sidecars share its network namespace).
# Traefik, Homepage, and Kuma read these for routing and health checks.
# Add a port here and in compose.yaml gluetun.ports when enabling a new sidecar.

GLUETUN_PORT_HTTPPROXY=8888
GLUETUN_PORT_CONTROL_SERVER=8080
SONARR_PORT=8989
RADARR_PORT=7878
PROWLARR_PORT=9696
BAZARR_PORT=6767
QBITTORRENT_WEBUI_PORT=9865


# =============================================================================
# qBittorrent
# Deploy: ansible/playbooks/deploy-qbittorrent.yml
# =============================================================================

QBITTORRENT_WEBUI_USERNAME=admin
QBITTORRENT_WEBUI_PASSWORD=
# Whitelist traefik_network so Traefik/Homepage skip WebUI login (Authelia handles external auth)
# *arr apps on gluetun still use QBITTORRENT_WEBUI_USERNAME/PASSWORD for the download-client API
QBITTORRENT_LAN_AUTH_BYPASS=true


# =============================================================================
# Media paths
# =============================================================================

MEDIA1_DIR=/mnt/media1
MEDIA2_DIR=/mnt/media2
AUDIOBOOKS_DIR=/mnt/audiobooks
DOWNLOADS_DIR=/path/to/downloads


# =============================================================================
# Dispatcharr
# Deploy: ansible/playbooks/deploy-dispatcharr.yml
# =============================================================================

# Admin account (UI + XC username)
DISPATCHARR_ADMIN_USERNAME=admin
DISPATCHARR_ADMIN_PASSWORD=
DISPATCHARR_ADMIN_EMAIL=admin@example.com
# Trust no proxy headers (recommended behind Traefik + Gluetun)
DISPATCHARR_TRUSTED_PROXIES=none
# Block web signup; admin is created by deploy-dispatcharr.yml
DISPATCHARR_SETUP_ALLOWED_IP=127.0.0.1

# M3U/XC provider
DISPATCHARR_M3U_NAME=MyProvider
DISPATCHARR_M3U_URL=http://your-provider.example.com
DISPATCHARR_M3U_USERNAME=
DISPATCHARR_M3U_PASSWORD=
# XC = Xtream Codes base URL + username/password; STD = direct M3U playlist URL
DISPATCHARR_M3U_ACCOUNT_TYPE=XC
# Max concurrent streams for this provider (0 = unlimited)
DISPATCHARR_M3U_MAX_STREAMS=1
# Scheduled provider refresh interval in hours (0 = disabled; auto channel sync runs after each refresh)
DISPATCHARR_M3U_REFRESH_INTERVAL=24

# XC password for IPTV clients (UHF, iPlayTV, etc.) — remote access via Traefik
# Username is DISPATCHARR_ADMIN_USERNAME; server URL is https://dispatch.${DOMAIN}
DISPATCHARR_XC_PASSWORD=


# =============================================================================
# Uptime Kuma + Autokuma
# Deploy: ansible/playbooks/deploy-uptime-kuma.yml, deploy-autokuma.yml
# =============================================================================

# Uptime Kuma dashboard auth is disabled (Authelia at Traefik edge). Ansible bootstraps
# fresh installs and syncs /status/default for the Homepage widget — no .env keys needed.
# Optional only if you re-enable Kuma dashboard auth:
# UPTIME_KUMA_USERNAME=
# UPTIME_KUMA_PASSWORD=

# Health-check URLs with API keys embedded (keeps keys out of compose.yaml)
# Optional — use if your *arr apps require an API key in the status URL
# KUMA_SONARR_URL=http://gluetun:${SONARR_PORT}/api/v3/system/status?apiKey=YOUR_KEY
# KUMA_RADARR_URL=http://gluetun:${RADARR_PORT}/api/v3/system/status?apiKey=YOUR_KEY
# KUMA_PROWLARR_URL=http://gluetun:${PROWLARR_PORT}/api/v1/system/status?apiKey=YOUR_KEY
# KUMA_BAZARR_URL=http://gluetun:${BAZARR_PORT}/api/system/status?apikey=YOUR_KEY
# KUMA_DISPATCHARR_URL=http://dispatcharr:9191


# =============================================================================
# Jellyscope — Jellyfin stats (tv-stats)
# Deploy: ansible/playbooks/deploy-jellyscope.yml
# =============================================================================

# Signs the login cookie — generate once:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JELLYSCOPE_SECRET_KEY=

# Instance admin (no OIDC — Authelia protects the edge only).
JELLYSCOPE_ADMIN_USERNAME=admin
JELLYSCOPE_ADMIN_PASSWORD=

# Jellyfin API key named "jellyscope" is read from jellyfin.db or created automatically
# by deploy-jellyscope.yml (no manual Dashboard step).


# =============================================================================
# Homepage
# Deploy: ansible/playbooks/deploy-homepage.yml
# =============================================================================

# Per-app API tokens — create in each service UI after the stack is up
# Jellyfin widget key named "homepage" is read from jellyfin.db or created by deploy-homepage.yml
HOMEPAGE_AUDIOBOOKSHELF_API_KEY=
HOMEPAGE_MEALIE_API_KEY=
HOMEPAGE_SONARR_API_KEY=
HOMEPAGE_RADARR_API_KEY=
HOMEPAGE_PROWLARR_API_KEY=
HOMEPAGE_SEERR_API_KEY=
HOMEPAGE_BAZARR_API_KEY=
