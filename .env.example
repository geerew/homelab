# Data root for all service volumes (e.g. /path/to/portainer or ./ for repo root)
DATA_DIR=./

# User/group for file ownership in containers (match your host user)
PUID=1000
PGID=1000

# Timezone for containers
TZ=Europe/London

# Primary domain (used for Traefik Host rules, app URLs, etc.)
DOMAIN=example.com

# Email for Traefik ACME/Let's Encrypt
ACME_EMAIL=admin@example.com

# Cloudflare API token (DDNS + Traefik ACME – used by cloudflare-ddns and Traefik)
CLOUDFLARE_API_TOKEN=

# Shared OIDC client secret for Authelia (used by Mealie, Yamtrack, Trilium; set same in Jellyfin/Audiobookshelf/Wallos)
OIDC_CLIENT_SECRET=

# Mealie – OpenAI for recipe features (optional)
MEALIE_OPENAI_API_KEY=

# Gluetun – Mullvad Wireguard
WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=10.x.x.x/32  # if not using SERVER_CITIES

# Host paths for media and downloads (adjust to your machine)
MEDIA1_DIR=/mnt/media1
MEDIA2_DIR=/mnt/media2
AUDIOBOOKS_DIR=/mnt/audiobooks
DOWNLOADS_DIR=/path/to/downloads

# Yamtrack – Django secret key (generate with: openssl rand -hex 32)
YAMTRACK_SECRET=

# Dispatcharr – admin bootstrap (used by ansible/playbooks/bootstrap-dispatcharr.yml)
DISPATCHARR_ADMIN_USERNAME=admin
DISPATCHARR_ADMIN_PASSWORD=
DISPATCHARR_ADMIN_EMAIL=admin@example.com
# Trust no proxy headers (recommended behind Traefik + Gluetun)
DISPATCHARR_TRUSTED_PROXIES=none
# Block web signup; admin is created by ansible/playbooks/bootstrap-dispatcharr.yml
DISPATCHARR_SETUP_ALLOWED_IP=127.0.0.1

# Yamtrack – promote existing user to Django admin (ansible/playbooks/bootstrap-yamtrack.yml)
# User must log in via Authelia once before running the playbook.
YAMTRACK_ADMIN_USERNAME=

# Uptime Kuma health-check URLs including API keys (so keys are not in compose)
# Optional: use if your *arr apps require API key in the status URL
# KUMA_SONARR_URL=http://gluetun:8989/api/v3/system/status?apiKey=YOUR_KEY
# KUMA_RADARR_URL=http://gluetun:7878/api/v3/system/status?apiKey=YOUR_KEY
# KUMA_PROWLARR_URL=http://gluetun:9696/api/v1/system/status?apiKey=YOUR_KEY
# KUMA_BAZARR_URL=http://gluetun:6767/api/system/status?apikey=YOUR_KEY
# KUMA_DISPATCHARR_URL=http://gluetun:9191
